#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="${SCRIPT_DIR}/workspace"
mkdir -p "${WORKSPACE_DIR}"

ENV_FILE="${SCRIPT_DIR}/.env"

TTY_FLAG="-i"
if [ -t 0 ] && [ -t 1 ]; then
    TTY_FLAG="-it"
fi

REMOTE_WS="/d/files/Contracted projects/IdeaProjects/orchestrator-ai-agent/workspace"

if [ "$#" -eq 0 ]; then
    docker run --rm ${TTY_FLAG} -v "${REMOTE_WS}:/workspace/orchestrator-ai-agent/workspace" --env-file "${ENV_FILE}" oragai:dev --check-config
else
    docker run --rm ${TTY_FLAG} -v "${REMOTE_WS}:/workspace/orchestrator-ai-agent/workspace" --env-file "${ENV_FILE}" oragai:dev "$@"
    # Sync back if on remote vm
    if ssh -o BatchMode=yes crowz-debian@192.168.85.129 true 2>/dev/null; then
        ssh -o BatchMode=yes crowz-debian@192.168.85.129 "tar -czf /tmp/oragai_ws_sync.tar.gz -C '$REMOTE_WS' ." 2>/dev/null || true
        scp -o BatchMode=yes crowz-debian@192.168.85.129:/tmp/oragai_ws_sync.tar.gz "${SCRIPT_DIR}/oragai_ws_sync.tar.gz" 2>/dev/null || true
        if [ -f "${SCRIPT_DIR}/oragai_ws_sync.tar.gz" ]; then
            tar -xzf "${SCRIPT_DIR}/oragai_ws_sync.tar.gz" -C "${WORKSPACE_DIR}"
            rm -f "${SCRIPT_DIR}/oragai_ws_sync.tar.gz"
            ssh -o BatchMode=yes crowz-debian@192.168.85.129 "rm -f /tmp/oragai_ws_sync.tar.gz" 2>/dev/null || true
        fi
    fi
fi
