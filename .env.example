# ==============================================================================
# ORAGAI (Orchestrated Resilient Autonomous Generative AI) - Environment Template
# Copy this file to .env and configure your preferred provider and API keys.
# ==============================================================================

# ==============================================================================
# 1. ACTIVE PROVIDER SELECTION
# ==============================================================================
# Supported Options:
#   - openrouter  : Multi-model gateway with generous free tiers (Recommended for $0 dev)
#   - gemini      : Direct Google Gemini API (Fast & Generous Free Tier)
#   - omniroute   : Local / Self-hosted AI Gateway (Default: http://localhost:20128/v1)
#   - groq        : Ultra-fast open-weight inference (Llama-3, etc.)
#   - openai      : Direct OpenAI models (GPT-4o, GPT-4o-mini)
#   - anthropic   : Direct Anthropic models (Claude 3.5 Sonnet)
#
PROVIDER=openrouter

# ==============================================================================
# 2. LLM PROVIDER API KEYS (SECRETS) & GATEWAY ENDPOINTS
# ==============================================================================
# Set the key for your active provider (only one key is required to start):
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ==============================================================================
# 3. GLOBAL MODEL SELECTION
# ==============================================================================
# Applied across all agent roles unless overridden in Section 4.
#
# Recommended Models by Provider:
#   - OpenRouter (100% Free):
        * openrouter/free
#       * openrouter/google/gemini-2.0-flash-exp:free (Fast & smart)
#       * openrouter/qwen/qwen-2.5-coder-32b-instruct:free (Top coding model)
#       * openrouter/meta-llama/llama-3.3-70b-instruct:free
#   - Google Gemini Direct:
#       * gemini/gemini-2.0-flash
#       * gemini/gemini-1.5-pro
#   - OpenAI:
#       * openai/gpt-4o-mini
#       * openai/gpt-4o
#   - Anthropic:
#       * anthropic/claude-3-5-sonnet-20241022
#   - OmniRoute:
#       * antigravity/gemini-3.7-flash-tiered
#       * omniroute/auto/best-coding
#
MODEL=openrouter/google/gemini-2.0-flash-exp:free

# ==============================================================================
# 4. PER-AGENT ROLE OVERRIDES (Optional)
# ==============================================================================
# Leave empty to inherit the global MODEL from Section 3.
DEVELOPER_MODEL=
TESTER_MODEL=
REVIEWER_MODEL=
ARCHITECT_MODEL=
DOCUMENTATION_MODEL=

# ==============================================================================
# 5. GITHUB PR REVIEW GATE AI MODEL (Optional)
# ==============================================================================
# Specifies the AI model used during automated Pull Request code reviews.
# Defaults to auto free-tier router on OpenRouter: openrouter/free
PR_REVIEW_MODEL=openrouter/free

# ==============================================================================
# 6. RUNTIME & SAFETY GOVERNANCE (Optional Environment Overrides)
# Note: Primary declarative configuration is managed in:
#       orchestrator/config/orchestrator.config.json
# Values defined here act as Tier-3 fallbacks in the 4-layer configuration cascade.
# ==============================================================================

# [WORKSPACE_PATH]: Target workspace directory for agent file operations
WORKSPACE_PATH=./workspace

# [MAX_BUDGET_USD]: Hard spending ceiling in USD per execution run
MAX_BUDGET_USD=0.50

# [MAX_TOKENS_BUDGET]: Cumulative token consumption ceiling per task
MAX_TOKENS_BUDGET=350000

# [MAX_ITERATIONS]: Maximum fix loop iterations for developer agent
MAX_ITERATIONS=4

# [CIRCUIT_BREAKER_THRESHOLD]: Threshold for consecutive identical failures before trip
CIRCUIT_BREAKER_THRESHOLD=2

# [CONVERSATION_TIMEOUT_SECONDS]: Max wall-clock seconds per conversation turn
CONVERSATION_TIMEOUT_SECONDS=300

# [AUTO_COMMIT]: Automatically create git commit upon successful verification (true/false)
AUTO_COMMIT=true

# [AUTO_CHAIN_AUDIT]: Automatically run static audit pass after dev completion (true/false)
AUTO_CHAIN_AUDIT=true

# [INTERACTIVE]: Enable interactive human approval gates (true/false)
INTERACTIVE=false

# [APPROVAL_GATES]: Comma-separated milestones requiring human sign-off: before_plan,after_architect,after_developer,before_commit
APPROVAL_GATES=before_plan,before_commit

# [ENABLE_MEMORY]: Enable cross-run historical memory injection (true/false)
ENABLE_MEMORY=true

# [VERBOSITY]: Console output verbosity level: quiet | normal | verbose
VERBOSITY=normal

# [SHOW_DIFF_PREVIEW]: Render syntax-highlighted diffs in terminal (true/false)
SHOW_DIFF_PREVIEW=true
