# ==============================================================================
# 1. ACTIVE PROVIDER SELECTION
# ==============================================================================
# Supported Options:
#   - gemini      : Direct Google Gemini API (Fast & Generous Free Tier)
#   - openrouter  : Aggregator supporting multiple models (Requires credits or daily quota)
#   - groq        : Ultra-fast open models (Llama-3, etc.)
#   - openai      : Direct OpenAI models (GPT-4o, GPT-4o-mini)
#   - anthropic   : Direct Anthropic models (Claude 3.5 Sonnet)
#
PROVIDER=openrouter

# ==============================================================================
# 2. LLM PROVIDER API KEYS (SECRETS)
# ==============================================================================
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ==============================================================================
# 3. GLOBAL MODEL (Applies across ALL agents if specific model below is empty)
# ==============================================================================
# Format by provider:
#   - Google Gemini : gemini/gemini-2.0-flash | gemini/gemini-1.5-flash | gemini/gemini-1.5-pro
#   - OpenRouter    : openrouter/z-ai/glm-5.2:free | openrouter/google/gemini-2.0-flash-exp:free
#   - Groq          : groq/llama-3.3-70b-versatile
#   - OpenAI        : openai/gpt-4o-mini | openai/gpt-4o
#   - Anthropic     : anthropic/claude-3-5-sonnet-20241022
#
MODEL=openrouter/z-ai/glm-5.2:free

# ==============================================================================
# 4. PER-AGENT ROLE OVERRIDES (Optional: leave empty to inherit MODEL above)
# ==============================================================================
# Example:
#   DEVELOPER_MODEL=gemini/gemini-2.0-flash
#   REVIEWER_MODEL=gemini/gemini-1.5-pro
#
DEVELOPER_MODEL=
TESTER_MODEL=
REVIEWER_MODEL=
ARCHITECT_MODEL=
DOCUMENTATION_MODEL=

# ==============================================================================
# 5. OPTIONAL ENVIRONMENT OVERRIDES
# Note: Declarative configuration is managed in orchestrator/config/orchestrator.config.json.
# ==============================================================================
WORKSPACE_PATH=./workspace
MAX_BUDGET_USD=0.50
CIRCUIT_BREAKER_THRESHOLD=2
APPROVAL_GATES=before_plan,before_commit
INTERACTIVE=false
ENABLE_MEMORY=true
