# LLM Provider API Keys (Set at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Agent Models Matrix (Customizable per role)
DEVELOPER_MODEL=openrouter/qwen/qwen3.8-27b:free
TESTER_MODEL=openrouter/qwen/qwen3.8-27b:free
REVIEWER_MODEL=openrouter/google/gemini-2.0-flash-exp:free
ARCHITECT_MODEL=openrouter/qwen/qwen3.8-27b:free
ORCHESTRATOR_MODEL=openrouter/qwen/qwen3.8-27b:free

# Workspace & Execution Settings
WORKSPACE_PATH=./workspace
MAX_ITERATIONS=4
AUTO_COMMIT=true

# Budget, Cost Controls & Safety Guards
MAX_BUDGET_USD=0.50
MAX_TOKENS_PER_CALL=4096
CIRCUIT_BREAKER_THRESHOLD=2
MAX_RETAINED_REPORTS=20

# Human-in-the-Loop & Gate Controls
INTERACTIVE=false
APPROVAL_GATES=before_plan,before_commit
VERBOSITY=normal

# Memory & Persistence
ENABLE_MEMORY=true
