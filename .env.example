# LLM Provider API Keys (Set at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Agent Models Matrix (Customizable per role)
DEVELOPER_MODEL=anthropic/claude-sonnet-4-5-20250929
TESTER_MODEL=openai/gpt-4o-mini
REVIEWER_MODEL=openai/gpt-4o
ARCHITECT_MODEL=anthropic/claude-sonnet-4-5-20250929
ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4-5-20250929

# Workspace & Execution Settings
WORKSPACE_PATH=./workspace
MAX_ITERATIONS=5
AUTO_COMMIT=true
